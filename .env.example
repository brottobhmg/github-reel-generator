# ── API Keys (LLM providers) ────────────────────────────────
# Copy this file to `.env` and fill in your real values.
# NEVER commit `.env` to git.

# Nvidia NIM (used as primary LLM provider)
NVIDIA_NIM_API_KEY=

# Groq (used for Whisper transcription and LLM fallback)
GROQ_API_KEY=

# OpenRouter (LLM fallback)
OPENROUTER_API_KEY=

# ── Telegram Bot ────────────────────────────────────────────
# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# ── Backend API ─────────────────────────────────────────────
# Polling server URL (see docs/ARCHITECTURE.md)
API_URL=http://localhost:8000

# ── Pipeline ────────────────────────────────────────────────
# Polling interval in seconds
POLL_INTERVAL=30
# Page load delay (seconds) during scroll recording
LOAD_DELAY=3.0
