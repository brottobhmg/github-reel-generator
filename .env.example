# ── API Keys (LLM providers) ────────────────────────────────
# Copia questo file in `.env` e inserisci i tuoi valori reali.
# NON committare mai `.env` su git.

# Nvidia NIM (usato come provider LLM primario)
NVIDIA_NIM_API_KEY=

# Groq (usato per trascrizione Whisper e fallback LLM)
GROQ_API_KEY=

# OpenRouter (fallback LLM)
OPENROUTER_API_KEY=

# ── Telegram Bot ────────────────────────────────────────────
# Token del bot Telegram (da @BotFather)
TELEGRAM_BOT_TOKEN=

# ── Backend API ─────────────────────────────────────────────
# URL del server di polling (vedi docs/ARCHITECTURE.md)
API_URL=http://localhost:8000

# ── Pipeline ────────────────────────────────────────────────
# Intervallo di polling in secondi
POLL_INTERVAL=30
# Ritardo di caricamento pagina (secondi) durante la registrazione scroll
LOAD_DELAY=3.0
